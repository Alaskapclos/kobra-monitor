# Standard: nur auf dem Server selbst erreichbar; passend für Tailscale Serve.
KOBRA_BIND_ADDRESS=127.0.0.1
# Klassisches VPN: stattdessen gezielt die private LAN-Adresse des Servers eintragen.
# Keinen Router-Port auf die Anwendung weiterleiten.

# Optional: Kammerlicht nur für explizit genannte Drucker freigeben; leer = Lesebetrieb.
# Beispiel: KOBRA_LIGHT_CONTROL_IPS=192.168.1.20
KOBRA_LIGHT_CONTROL_IPS=

# Optional: nur die drei angezeigten Lüfter ausgewählter S1 freigeben.
KOBRA_FAN_CONTROL_IPS=

# Optional: Speed Mode nur bei laufendem, aktuell gemeldetem Druck.
KOBRA_SPEED_CONTROL_IPS=

# Optional: Solltemperatur von Düse und Bett ausgewählter S1, erst nach OK.
KOBRA_TEMPERATURE_CONTROL_IPS=
