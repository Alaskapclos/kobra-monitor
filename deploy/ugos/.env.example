# Hier die tatsächliche private LAN-IP des NAS eintragen.
KOBRA_BIND_ADDRESS=192.168.1.20
# Für Tailscale Serve auf dem NAS stattdessen 127.0.0.1 verwenden.

# Optional: Kammerlicht nur für explizit genannte Drucker freigeben; leer = Lesebetrieb.
# Beispiel: KOBRA_LIGHT_CONTROL_IPS=192.168.1.20
KOBRA_LIGHT_CONTROL_IPS=

# Optional: nur die drei angezeigten Lüfter ausgewählter S1 freigeben.
KOBRA_FAN_CONTROL_IPS=

# Optional: Speed Mode nur bei laufendem, aktuell gemeldetem Druck.
KOBRA_SPEED_CONTROL_IPS=

# Experimentell: Archivwiederholung separat pro S1 freigeben. Leer = gesperrt.
# Erst nach kontrollierter Abnahme des Originalpaket-Uploads und Starts aktivieren.
KOBRA_ARCHIVE_START_IPS=

# Optional ACE drying controls, separately enabled for verified S1 addresses.
KOBRA_DRYING_CONTROL_IPS=
# Default 55 C. Explicitly confirmed ACE 2 Pro addresses may be mapped to 65.
KOBRA_DRYING_TEMPERATURE_LIMITS={}
